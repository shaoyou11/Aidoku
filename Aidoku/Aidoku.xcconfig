// base identifiers
APP_ID_PREFIX               = com.shaoyou11
APP_ID_SUFFIX               = Aidoku

PRODUCT_BUNDLE_IDENTIFIER   = $(APP_ID_PREFIX).$(APP_ID_SUFFIX)

// ----- iCloud / CloudKit -----
ICLOUD_CONTAINER_ID         = iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
UBIQUITY_KVSTORE_ID         = $(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)

// Store build
// Dev / sideload build (leave flag 'CANONICAL_BUILD' undefined)
OTHER_SWIFT_FLAGS = $(inherited)

// Personal developer team for cloud and local builds
DEVELOPMENT_TEAM = NMC7WK2KZ9

// Local personal-team signing
CODE_SIGN_ENTITLEMENTS = PersonalSigning.entitlements
#include? "PersonalSigning.local.xcconfig"
